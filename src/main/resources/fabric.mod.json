{
  "schemaVersion": 1,
  "id": "saturn-logo-builder",
  "version": "${version}",
  "name": "Saturn Logo Builder",
  "description": "Addon that builds schematics",
  "authors": [
    "Vulgur"
  ],
  "contact": {
    "sources": "https://github.com/SaturnHosting/saturn-logo-addon"
  },
  "icon": "assets/template/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "lat.saturn.addon.LogoBuilder"
    ]
  },
  "mixins": [
    "saturn-logo-builder.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
